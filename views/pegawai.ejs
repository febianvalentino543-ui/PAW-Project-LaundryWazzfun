<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= judul %></title>
    <!-- Menghubungkan CSS Eksternal khusus pegawai -->
    <link rel="stylesheet" href="/css/pegawai.css">
</head>
<body>

    <!-- Top Navigation Bar -->
    <header class="top-bar">
        <div class="brand">
            <span class="brand-icon">🧺</span>
            <h2>Wazzfun Monitoring</h2>
        </div>
        <div class="user-profile">
            <span class="user-role">Pegawai Shift 1</span>
            <a href="/" class="btn-logout">Ke Landing Page</a>
        </div>
    </header>

    <div class="layout-container">
        <!-- Sidebar Filter Status -->
        <aside class="sidebar">
            <h3>Menu Navigasi</h3>
            <ul class="filter-list">
                <li class="filter-item active"><a href="/pegawai" style="text-decoration:none; color:inherit;">Portal Pegawai</a></li>
                <li class="filter-item"><a href="/owner" style="text-decoration:none; color:inherit;">Owner Dashboard</a></li>
            </ul>
        </aside>

        <!-- Main Workspace -->
        <main class="content-area">
            <div class="workspace-header">
                <div>
                    <h1>Daftar Pengerjaan Laundry</h1>
                    <p>Klik tombol status pada card pelanggan untuk memperbarui progres langsung ke Backend.</p>
                </div>
            </div>

            <!-- List Card Pesanan Pelanggan -->
            <div class="orders-grid" id="ordersContainer">
                <% pesanan.forEach(item => { %>
                    <div class="order-card" data-id="<%= item.id %>">
                        <div class="card-top">
                            <div>
                                <span class="order-id">#<%= item.id %></span>
                                <h3 class="client-name"><%= item.customerName %></h3>
                                <span class="client-phone">📱 <%= item.phone %></span>
                            </div>
                            <span class="status-pill status-diterima" id="badge-<%= item.id %>"><%= item.status %></span>
                        </div>

                        <div class="card-info">
                            <p><strong>Paket:</strong> <%= item.service %></p>
                            <p><strong>Jumlah/Catatan:</strong> <%= item.weightQty %></p>
                            <p class="time-stamp">⏱️ Masuk: <%= item.enteredTime %></p>
                        </div>

                        <div class="step-control">
                            <label>Update Status Pengerjaan:</label>
                            <div class="step-buttons">
                                <button class="btn-step" onclick="updateStatus('<%= item.id %>', 'Diterima')">Diterima</button>
                                <button class="btn-step" onclick="updateStatus('<%= item.id %>', 'Sedang Dicuci')">Dicuci</button>
                                <button class="btn-step" onclick="updateStatus('<%= item.id %>', 'Sedang Disetrika')">Disetrika</button>
                                <button class="btn-step btn-complete" onclick="updateStatus('<%= item.id %>', 'Siap Diambil')">Siap Diambil</button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </main>
    </div>

    <!-- Script Integrasi Update Status ke Backend -->
    <script>
        async function updateStatus(idNota, statusBaru) {
            try {
                const response = await fetch(`/api/pesanan/${idNota}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: statusBaru })
                });
                const result = await response.json();

                if (result.sukses) {
                    alert(`[SUCCESS BACKEND]\nStatus Pesanan ${idNota} berhasil diperbarui menjadi: "${statusBaru}".`);
                    document.getElementById(`badge-${idNota}`).innerText = statusBaru;
                } else {
                    alert('Gagal memperbarui status.');
                }
            } catch (err) {
                console.error('Error:', err);
                alert('Terjadi kesalahan koneksi server.');
            }
        }
    </script>
</body>
</html>