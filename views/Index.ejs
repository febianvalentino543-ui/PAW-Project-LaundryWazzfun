<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= judul %></title>
    <!-- Menghubungkan CSS Eksternal dari folder views/css/style.css -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <!-- Header Utama & Navigasi -->
    <header>
        <div class="logo-container">
            <!-- Menghubungkan Asset Logo -->
            <img src="/Assets/logo.png" alt="Wazzfun Laundry Logo" onerror="this.style.display='none'">
            <div class="brand-text">
                <h1><%= namaToko %></h1>
                <p>BANDUNG • EXPRESS & QUALITY</p>
            </div>
        </div>

        <nav>
            <a href="/" class="nav-btn active">Pelanggan</a>
            <a href="/pegawai" class="nav-btn">Portal Pegawai</a>
            <a href="/owner" class="nav-btn">Owner Dashboard</a>
        </nav>
    </header>

    <!-- Konten Utama -->
    <main>
        <!-- Seksi Hero & Cek Status Cucian -->
        <section id="hero" class="hero-section">
            <div class="hero-left">
                <span class="badge-tag">Terintegrasi AI Assistant & WhatsApp Realtime</span>
                <h2>Cucian Bersih, Rapi & Ketepatan Waktu Terjamin.</h2>
                <p>Wazzfun Laundry hadir di Bandung dengan layanan express berkualitas tinggi. Cek status cucian secara instan melalui sistem otomatis WhatsApp AI tanpa perlu menunggu lama.</p>
                
                <!-- Form Cek Status Instan -->
                <form id="formCekStatus" onsubmit="handleCekStatus(event)" class="search-box">
                    <div class="input-wrapper">
                        <input type="text" id="idNota" name="idNota" placeholder="Masukkan ID Nota (contoh: WZ-1001)" required>
                        <button type="submit" class="btn-primary">Cek Status &rarr;</button>
                    </div>
                </form>
                <p class="hint-text">💡 Coba ketik ID Nota: <strong>WZ-1001</strong> atau <strong>WZ-1002</strong></p>
            </div>

            <!-- Card Demo Preview WhatsApp AI Realtime -->
            <div class="hero-right">
                <div class="status-preview-card">
                    <div class="card-header">
                        <div class="status-bot-info">
                            <span class="icon-wa">💬</span>
                            <div>
                                <h3>AI WhatsApp Status Bot</h3>
                                <p>Respon Otomatis &lt; 2 Detik</p>
                            </div>
                        </div>
                        <span class="badge-online">Aktif</span>
                    </div>

                    <div class="card-body" id="result-preview-box">
                        <span class="sub-label">CONTOH STATUS REALTIME</span>
                        <div class="order-info-header">
                            <h4 id="preview-title">Pesanan #WZ-1001 (Bpk. Agus)</h4>
                            <span class="badge-status-progress" id="preview-status">👕 Sedang Disetrika</span>
                        </div>
                        <p class="order-detail-text" id="preview-detail">Express Setrika 24 Jam (3kg)</p>
                        
                        <!-- Step Progress Indicator -->
                        <div class="progress-bar-wrapper">
                            <div class="progress-bar-fill" id="preview-bar" style="width: 75%;"></div>
                        </div>
                        <div class="progress-steps">
                            <span class="step completed">Diterima</span>
                            <span class="step completed">Dicuci</span>
                            <span class="step active">Disetrika</span>
                            <span class="step">Siap Diambil</span>
                        </div>
                    </div>

                    <div class="card-footer">
                        <p>⏰ Estimasi Selesai: <strong id="preview-est">Hari ini, 17:00 WIB</strong></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Seksi Daftar Layanan & Harga -->
        <section id="layanan" class="card-section">
            <div class="section-title text-center">
                <span class="badge-tag-alt">DAFTAR LAYANAN & HARGA</span>
                <h2>Pilihan Paket & Jenis Layanan</h2>
                <p>Transparan dan terjangkau untuk kategori pakaian harian serta perlengkapan tidur.</p>
            </div>

            <!-- SECTION 1: PAKAIAN -->
            <div class="catalog-category-box">
                <h3 class="category-title">👕 Pakaian</h3>
                <div class="table-responsive">
                    <table class="catalog-table">
                        <thead>
                            <tr>
                                <th>Paket</th>
                                <th>Jenis layanan</th>
                                <th class="text-right">Harga</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Reguler (2–3 hari)</td>
                                <td>Cuci lipat</td>
                                <td class="text-right">Rp7.000/kg</td>
                            </tr>
                            <tr>
                                <td>Reguler (2–3 hari)</td>
                                <td>Cuci setrika</td>
                                <td class="text-right">Rp8.000/kg</td>
                            </tr>
                            <tr>
                                <td>Express (1 hari)</td>
                                <td>Cuci lipat</td>
                                <td class="text-right">Rp9.000/kg</td>
                            </tr>
                            <tr>
                                <td>Express (1 hari)</td>
                                <td>Cuci setrika</td>
                                <td class="text-right">Rp12.000/kg</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Seksi Form Self-Service / Pendaftaran Pesanan Baru -->
        <section id="form-pesanan" class="card-section" style="margin-top: 3rem;">
            <div class="section-title text-center">
                <span class="badge-tag-alt">SELF-SERVICE & INPUT PESANAN</span>
                <h2>Buat Pesanan Laundry Baru</h2>
                <p>Lengkapi data di bawah ini untuk mencatat pesanan baru dan menghubungkannya dengan WhatsApp AI Assistant.</p>
            </div>

            <div class="form-container-card" style="max-width: 800px; margin: 0 auto; background: var(--card-bg); padding: 2.5rem; border-radius: 16px; border: 1px solid var(--border-color); box-shadow: var(--shadow);">
                <form id="formInputPesanan" onsubmit="handleSimpanPesanan(event)">
                        
                    <!-- 1. Input Nama Pelanggan -->
                    <div class="form-group">
                        <label for="inputNama">1. Nama Lengkap Pelanggan</label>
                        <input type="text" id="inputNama" name="customerName" placeholder="Contoh: Bpk. Umuh Muchtar" required>
                        <small id="errorNama" style="color: #e53e3e; font-size: 0.8rem; display: none; margin-top: 0.3rem;"></small>
                    </div>

                    <!-- 2. Nomor WhatsApp -->
                    <div class="form-group">
                        <label for="inputWa">2. Nomor WhatsApp Pelanggan</label>
                        <input type="text" id="inputWa" name="phone" placeholder="Contoh: 628123456789" required>
                        <small id="errorWa" style="color: #e53e3e; font-size: 0.8rem; display: none; margin-top: 0.3rem;"></small>
                    </div>

                    <!-- 3. Catatan Khusus -->
                    <div class="form-group">
                        <label for="inputCatatan">3. Catatan Khusus (Opsional)</label>
                        <textarea id="inputCatatan" name="catatan" rows="2" placeholder="Contoh: Jangan disikat terlalu keras."></textarea>
                    </div>

                    <!-- 4. Pilih Paket -->
                    <div class="form-group">
                        <label for="pilihPaket">4. Pilih Kategori & Jenis Layanan Paket</label>
                        <select id="pilihPaket" name="service" class="form-control-select" required>
                            <option value="" disabled selected>-- Pilih Kategori & Paket Layanan --</option>
                            <optgroup label="👕 Pakaian (Kiloan)">
                                <option value="Pakaian - Reguler Cuci Lipat (Rp7.000/kg)|7000">Pakaian: Reguler - Cuci Lipat (Rp7.000/kg)</option>
                                <option value="Pakaian - Reguler Cuci Setrika (Rp8.000/kg)|8000">Pakaian: Reguler - Cuci Setrika (Rp8.000/kg)</option>
                                <option value="Pakaian - Express Cuci Setrika (Rp12.000/kg)|12000">Pakaian: Express - Cuci Setrika (Rp12.000/kg)</option>
                            </optgroup>
                        </select>
                    </div>

                    <!-- 5. Input Berat / Jumlah -->
                    <div class="form-group">
                        <label for="inputBerat">5. Input Berat / Jumlah (Kg atau Pcs)</label>
                        <input type="number" step="0.1" id="inputBerat" name="weightQty" placeholder="Contoh: 3.5" required>
                        <small id="errorBerat" style="color: #e53e3e; font-size: 0.8rem; display: none; margin-top: 0.3rem;"></small>
                    </div>

                    <!-- Estimasi Total Biaya -->
                    <div class="estimation-box" style="background: var(--bg-light); padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                        <span>Estimasi Total Biaya:</span>
                        <strong id="labelEstimasiTotal" style="font-size: 1.2rem; color: var(--primary-color);">Rp 0</strong>
                    </div>

                    <button type="submit" id="btnSubmit" class="btn-primary btn-submit" style="width: 100%;">Simpan Pesanan & Kirim Nota ke WhatsApp &rarr;</button>
                </form>
            </div>
        </section>
    </main>

    <!-- Footer Utama -->
    <footer>
        <p>&copy; 2026 <%= namaToko %>. Hak Cipta Dilindungi.</p>
    </footer>

    <!-- SCRIPT EVENT HANDLING & API FETCH -->
    <script>
        const inputNama = document.getElementById('inputNama');
        const errorNama = document.getElementById('errorNama');
        const inputWa = document.getElementById('inputWa');
        const errorWa = document.getElementById('errorWa');
        const inputBerat = document.getElementById('inputBerat');
        const errorBerat = document.getElementById('errorBerat');
        const pilihPaket = document.getElementById('pilihPaket');
        const labelEstimasiTotal = document.getElementById('labelEstimasiTotal');

        let hargaSatuan = 0;

        // 1. Event Handling: Validasi Nama (Minimal 3 Karakter)
        inputNama.addEventListener('input', function() {
            const val = inputNama.value.trim();
            if (val.length < 3 && val.length > 0) {
                errorNama.style.display = 'block';
                errorNama.innerText = `Nama pelanggan minimal 3 karakter (sekarang ${val.length}).`;
                inputNama.style.borderColor = '#e53e3e';
            } else {
                errorNama.style.display = 'none';
                inputNama.style.borderColor = '#e2e8f0';
            }
        });

        // 2. Event Handling: Validasi Nomor WhatsApp (Minimal 10 Digit)
        inputWa.addEventListener('input', function() {
            const val = inputWa.value.trim();
            if (val.length < 10 && val.length > 0) {
                errorWa.style.display = 'block';
                errorWa.innerText = `Nomor WhatsApp minimal 10 digit (sekarang ${val.length} digit).`;
                inputWa.style.borderColor = '#e53e3e';
            } else {
                errorWa.style.display = 'none';
                inputWa.style.borderColor = '#e2e8f0';
            }
        });

        // 3. Event Handling: Paket Dipilih
        pilihPaket.addEventListener('change', function() {
            const parts = pilihPaket.value.split('|');
            hargaSatuan = parseInt(parts[1]) || 0;
            hitungTotal();
        });

        // 4. Event Handling: Validasi Berat (Minimal 1)
        inputBerat.addEventListener('input', function() {
            const berat = parseFloat(inputBerat.value) || 0;
            if (berat < 1 && inputBerat.value !== '') {
                errorBerat.style.display = 'block';
                errorBerat.innerText = 'Berat atau jumlah minimal bernilai 1.';
                inputBerat.style.borderColor = '#e53e3e';
            } else {
                errorBerat.style.display = 'none';
                inputBerat.style.borderColor = '#e2e8f0';
            }
            hitungTotal();
        });

        function hitungTotal() {
            const berat = parseFloat(inputBerat.value) || 0;
            const total = hargaSatuan * berat;
            labelEstimasiTotal.innerText = 'Rp ' + total.toLocaleString('id-ID');
        }

        // 5. Fetch API: Cek Status Nota
        async function handleCekStatus(e) {
            e.preventDefault();
            const idNota = document.getElementById('idNota').value.trim();
            
            try {
                const response = await fetch(`/api/pesanan/${idNota}`);
                const result = await response.json();

                if (result.sukses) {
                    const data = result.data;
                    document.getElementById('preview-title').innerText = `Pesanan #${data.id} (${data.customerName})`;
                    document.getElementById('preview-status').innerText = data.status;
                    document.getElementById('preview-detail').innerText = `${data.service} (${data.weightQty})`;
                    alert(`Status ditemukan: Pesanan #${data.id} milik ${data.customerName} saat ini berstatus "${data.status}"`);
                } else {
                    alert('Maaf, ID Nota tidak ditemukan di sistem.');
                }
            } catch (err) {
                console.error('Gagal mengambil data:', err);
                alert('Terjadi kesalahan koneksi ke server.');
            }
        }

        // 6. Submit Simpan Pesanan (Kirim ke Backend POST /api/pesanan)
        async function handleSimpanPesanan(e) {
            e.preventDefault();

            const nama = inputNama.value.trim();
            const whatsapp = inputWa.value.trim();
            const catatan = document.getElementById('inputCatatan').value.trim();
            const paketVal = pilihPaket.value;
            const berat = inputBerat.value;

            if (!paketVal) {
                alert('Silakan pilih kategori dan paket layanan terlebih dahulu.');
                return;
            }

            if (nama.length < 3) {
                alert('Nama pelanggan minimal 3 karakter.');
                return;
            }

            if (whatsapp.length < 10) {
                alert('Nomor WhatsApp minimal 10 digit.');
                return;
            }

            const [namaPaket, strHarga] = paketVal.split('|');
            const hargaSatuan = parseInt(strHarga);
            const totalHarga = hargaSatuan * parseFloat(berat);

            const dataPesananBaru = {
                customerName: nama,
                phone: whatsapp,
                service: namaPaket,
                weightQty: berat + (namaPaket.includes('Bedcover') ? ' pcs' : ' kg'),
                totalHarga: totalHarga,
                catatan: catatan
            };

            try {
                const response = await fetch('/api/pesanan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dataPesananBaru)
                });

                const result = await response.json();

                if (result.sukses) {
                    alert(`[SUKSES] Pesanan #${result.data.id} atas nama ${nama} berhasil disimpan ke Database PostgreSQL!\n\nNota digital & rincian total (Rp ${totalHarga.toLocaleString('id-ID')}) dikirim ke WhatsApp: ${whatsapp}`);
                    document.getElementById('formInputPesanan').reset();
                    labelEstimasiTotal.innerText = 'Rp 0';
                } else {
                    alert('Gagal menyimpan: ' + result.pesan);
                }
            } catch (err) {
                console.error('Gagal menyimpan pesanan:', err);
                alert('Terjadi kesalahan koneksi ke server.');
            }
        }
    </script>
</body>
</html>